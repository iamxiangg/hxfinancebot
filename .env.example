# hxfinancebot environment variables
# Copy this to `.env` and fill in your values. `.env` is git-ignored by the
# `*.env` pattern in `.gitignore`.
#
# Loading options for your shell:
#   - Bash (one shot):    set -a && source .env && set +a
#   - Python (anywhere): from dotenv import load_dotenv; load_dotenv()

# =============================================================================
# Google Sheets (required for funnel operations)
# =============================================================================
# Path to your Google Cloud service account JSON key file. The
# `gcp_service_account.json` saved at the project root is git-ignored by
# the `gcp_service_account*.json` rule in `.gitignore`. Adjust if you keep
# the credential elsewhere.
GCP_SERVICE_ACCOUNT_FILE=gcp_service_account.json

# The Google Sheets spreadsheet ID (from the sheet URL)
GOOGLE_SHEET_ID=

# =============================================================================
# SEC EDGAR access (required for insider scanner)
# =============================================================================
# A descriptive contact string per SEC EDGAR fair-access rules.
# This is NOT an account or API key. Example: hxfinancebot contact@example.com
SEC_USER_AGENT=

# Provider backend: "official" (default) or "edgartools"
# SEC_PROVIDER=official

# Rate limit: requests per second
# SEC_MAX_REQUESTS_PER_SECOND=5

# Request timeout in seconds
# SEC_REQUEST_TIMEOUT=30

# Disk cache TTL in hours
# SEC_CACHE_TTL_HOURS=24

# Cache directory
# SEC_CACHE_DIR=funnel_output/sec_cache

# =============================================================================
# Alpha Vantage (optional, for VPMA earnings-estimate enrichment)
# =============================================================================
# Free API key from https://www.alphavantage.co/support/#api-key
# ALPHA_VANTAGE_FREE=

# =============================================================================
# OpenAI (optional, for Feroldi AI draft generation)
# =============================================================================
# OPENAI_API_KEY=

# =============================================================================
# Telegram (optional, for review notifications)
# =============================================================================
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Disable Telegram notifications
# SEND_TELEGRAM_REVIEWS=false

# Force resend all reviews (use sparingly)
# FORCE_TELEGRAM_REVIEW_RESEND=false

# =============================================================================
# Congress political digest
# =============================================================================
# POLITICAL_DIGEST_ENABLED=true
# POLITICAL_DIGEST_LEGACY_OUTPUT=false
# POLITICAL_DIGEST_SEND_TELEGRAM=true
# POLITICAL_DIGEST_SEND_EMPTY=true
# POLITICAL_DIGEST_MAX_DETAILED_FLAGS=3
# POLITICAL_DIGEST_HARD_MAX_DETAILED_FLAGS=5
# POLITICAL_ARCHIVE_BACKEND=auto
# POLITICAL_BACKFILL_TRADE_THRESHOLD=200
# POLITICAL_BACKFILL_FILING_THRESHOLD=25
# POLITICAL_BACKFILL_TICKER_THRESHOLD=50
# POLITICAL_FLAG_PURCHASE_LOW=100000
# POLITICAL_FLAG_CALL_LOW=100000
# POLITICAL_FLAG_SALE_LOW=100000
# POLITICAL_BROAD_MIN_BUYERS=2
# POLITICAL_CONCENTRATION_THRESHOLD=0.70

# =============================================================================
# Insider scanner
# =============================================================================
# Business days of SEC daily index to scan
# INSIDER_LOOKBACK_DAYS=7

# Days of purchase history for cluster detection
# INSIDER_HISTORY_DAYS=365

# Max days between insider purchases in a cluster
# INSIDER_CLUSTER_DAYS=21

# Signal validity period in days
# INSIDER_VALID_DAYS=14

# Minimum price filter
# INSIDER_MIN_PRICE=3.0

# Minimum median dollar volume
# INSIDER_MIN_MEDIAN_DOLLAR_VOLUME=5000000

# Minimum single-buy value for single-insider exception
# INSIDER_SINGLE_BUY_MIN_VALUE=250000

# Max results returned
# INSIDER_MAX_RESULTS=20

# Insider ledger backend: "auto" (Google Sheets if available) or "local" (JSON)
# INSIDER_LEDGER_BACKEND=auto

# =============================================================================
# VPMA scanner
# =============================================================================
# Enable Alpha Vantage enrichment
# VPMA_ENABLE_ENRICHMENT=true

# Max tickers to enrich per run
# VPMA_MAX_ENRICH=20

# Days to look back for earnings events
# VPMA_EVENT_LOOKBACK_DAYS=90

# Signal validity period in days
# VPMA_VALID_DAYS=3

# Minimum price / market cap / volume filters
# VPMA_MIN_PRICE=3.0
# VPMA_MIN_MARKET_CAP=300000000
# VPMA_MIN_SOURCE_VOLUME=200000
# VPMA_MIN_MEDIAN_DOLLAR_VOLUME=5000000

# Comma-separated tickers for testing (skips universe download)
# VPMA_TEST_TICKERS=

# Enable SEC guidance confirmation
# VPMA_GUIDANCE_ENABLE=true

# Max tickers for guidance pass
# VPMA_GUIDANCE_MAX_TICKERS=10

# =============================================================================
# Review funnel
# =============================================================================
# Which scanner sources to run (comma-separated)
# Options: congress, vpma, insider, fundamental_inflection, manual
# REVIEW_SOURCES=congress,vpma,insider,fundamental_inflection,manual

# BTD gate threshold (BTD ratio below this passes)
# BTD_GATE_THRESHOLD=1.0

# Bypass BTD gate for manual-only candidates
# BTD_GATE_MANUAL_BYPASS=true

# Max candidates to enrich with BTD per run
# BTD_ENRICH_LIMIT=10

# Feroldi gate: "observe" (log only) or "enforce" (block)
# FEROLDI_GATE_MODE=observe

# Feroldi pass threshold
# FEROLDI_GATE_PASS_THRESHOLD=30.0

# Feroldi review threshold
# FEROLDI_GATE_REVIEW_THRESHOLD=25.0

# Feroldi minimum coverage ratio
# FEROLDI_GATE_MIN_COVERAGE=0.75

# Allow Feroldi review gate
# FEROLDI_GATE_ALLOW_REVIEW=true

# =============================================================================
# Congress scanner
# =============================================================================
# Minimum conviction score
# MIN_CONVICTION=15.0

# =============================================================================
# Sheet beautifier (funnel/sheet_beautifier.py)
# =============================================================================
# Thresholds for the saved filter view `Strong Congress, BTD-Rejected` on the
# BTD_Candidates sheet. The view re-applies cleanly on every beautifier run
# (idempotent — won't create duplicate views).
BTD_FILTER_MIN_ACTIVE_PURCHASES=4
BTD_FILTER_MIN_UNIQUE_MEMBERS=2

# Comma-separated sheet names to beautify. Empty = all production sheets.
# BEAUTIFY_SHEETS=BTD_Candidates,Signal_Log
